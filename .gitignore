.vscode/
.idea/
*.iml
*.ipr
*.iws
.DS_Store
Thumbs.db

# 数据库文件
*.db
*.sqlite
*.sqlite3

# 配置文件中的敏感信息
config/local.yaml
config/production.yaml
.env.production

# 测试覆盖率
coverage.txt
coverage.html
*.cover

# 依赖目录
node_modules/
.pnp
.pnp.js

